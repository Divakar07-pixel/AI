<Application x:Class="Jarvis.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="NightColor">#070B16</Color>
        <Color x:Key="PanelColor">#10182A</Color>
        <Color x:Key="CyanColor">#5DE4FF</Color>
        <Color x:Key="VioletColor">#8875FF</Color>
        <Color x:Key="MutedColor">#9AA9C4</Color>
        <SolidColorBrush x:Key="NightBrush" Color="{StaticResource NightColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
        <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Foreground" Value="#070B16" />
            <Setter Property="Background" Value="{StaticResource CyanBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0B1222" />
            <Setter Property="BorderBrush" Value="#2B3B57" />
            <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Application.Resources>
</Application>
